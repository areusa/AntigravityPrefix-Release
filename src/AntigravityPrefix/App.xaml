    <SolidColorBrush x:Key="BackgroundBrush" Color="#141416"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202024"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#34343A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F4F5"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#202024"/>
      <Setter Property="BorderBrush" Value="#34343A"/><Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Box" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="#303037"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#A3E635"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.94" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.20"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#55555E"/><Setter Property="Cursor" Value="Hand"/>
      <!-- 保留键盘与无障碍操作，但不绘制焦点框；置顶状态只由图形和颜色表达。 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="PinBox" CornerRadius="9" Background="Transparent" BorderThickness="0">
          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
            <Path x:Name="PinOff" Data="{StaticResource PinOffGeometry}" Fill="{TemplateBinding Foreground}"/>
            <Path x:Name="PinOn" Data="{StaticResource PinOnGeometry}" Fill="#FFFFFF" Visibility="Collapsed"/>
          </Canvas></Viewbox>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinBox" Property="Background" Value="#303037"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="PinBox" Property="Background" Value="#3A3A43"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="PinOff" Property="Visibility" Value="Collapsed"/><Setter TargetName="PinOn" Property="Visibility" Value="Visible"/>
            <Setter Property="ToolTip" Value="置顶已开启 · 点击关闭"/>
          </Trigger>
          <Trigger Property="IsChecked" Value="False"><Setter Property="ToolTip" Value="置顶已关闭 · 点击开启"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DisabledPinStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.30"/></Trigger></Style.Triggers>
    </Style>
    <!-- 小条所有命中区与状态底框共用模板，不继承完整窗口的按压缩放。 -->
    <Style x:Key="CompactActionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="{x:Static local:CompactMetrics.ActionSize}"/><Setter Property="Height" Value="{x:Static local:CompactMetrics.ActionSize}"/>
      <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B7B8C2"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="SnapsToDevicePixels" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid x:Name="HitFrame">
          <Border Background="#01000000" CornerRadius="8"/>
          <Grid x:Name="MotionFace" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
          <local:SmoothBorder x:Name="BaseFrame" CornerRadius="{x:Static local:CompactMetrics.ButtonRadius}" Background="{TemplateBinding Background}"/>
          <local:SmoothBorder x:Name="InteractionFrame" CornerRadius="{x:Static local:CompactMetrics.ButtonRadius}" Background="#303037" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter x:Name="GlyphPresenter" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
            <MultiTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiTrigger.EnterActions>
            <MultiTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="InteractionFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></MultiTrigger.ExitActions>
          </MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions><Setter TargetName="InteractionFrame" Property="Background" Value="#3A3A43"/></MultiTrigger>
          <!-- 离屏预览使用同一模板和底框，不伪造鼠标输入。 -->
          <Trigger Property="local:CompactMetrics.PreviewInteraction" Value="Hover"><Setter TargetName="InteractionFrame" Property="Opacity" Value="1"/></Trigger>
          <Trigger Property="local:CompactMetrics.PreviewInteraction" Value="Pressed"><Setter TargetName="InteractionFrame" Property="Opacity" Value="1"/><Setter TargetName="InteractionFrame" Property="Background" Value="#3A3A43"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.20"/></Trigger></Style.Triggers>
    </Style>
    <!-- 受阻只覆盖语义颜色和禁用可见性，不能复制模板或改变几何。 -->
    <Style x:Key="CompactFeedbackButtonStyle" TargetType="Button" BasedOn="{StaticResource CompactActionButtonStyle}">
      <Setter Property="Background" Value="#AE2B42"/><Setter Property="Foreground" Value="White"/>
      <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="1"/></Trigger></Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
